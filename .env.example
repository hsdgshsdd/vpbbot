# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Marzneshin API Configuration (OAuth2 PasswordBearer)
# API_BASE_URL: URL вашего сервера Marzneshin
# API_USERNAME: логин администратора в Marzneshin панели
# API_PASSWORD: пароль администратора в Marzneshin панели
API_BASE_URL=http://localhost:8000
API_USERNAME=admin_username_here
API_PASSWORD=admin_password_here

# Bot Configuration
DB_PATH=data/bot.db
DEBUG=True

# Payment Configuration
CURRENCY=RUB
